# Token from the private Vercel Blob store `jundiai-career-shares`.
# Required in production so /ver/XXXXXXXX links work on any device.
# The Vercel project jundiai-career already has this variable
# (production, preview, and development). Do not commit the real token.
# Locally, leave it empty: snapshots are written to .data/shares/ instead.
BLOB_READ_WRITE_TOKEN=
